#!/bin/sh
# Remove AI-attribution lines ("Co-Authored-By:", "Claude-Session:", "Generated with ...") from commit messages.
# Installed by scripts/setup-hooks.sh.
msg_file="$1"
tmp="$(mktemp)"
grep -viE '^[[:space:]]*(co-authored-by:|claude-session:|.*generated with)' "$msg_file" > "$tmp" || true
# Drop trailing blank lines left behind.
sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" > "$msg_file"
rm -f "$tmp"
