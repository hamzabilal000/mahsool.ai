# Copy to .env and fill in. Never commit .env.

# --- Ingestion ---
MAHSOOL_DATA_DIR=data
MAHSOOL_MAX_CHUNK_TOKENS=800

# --- LLM (Groq) ---
GROQ_API_KEY=
MAHSOOL_ANSWER_MODEL=openai/gpt-oss-120b
MAHSOOL_REWRITE_MODEL=openai/gpt-oss-20b

# --- Retrieval ---
MAHSOOL_EMBEDDING_MODEL=BAAI/bge-m3
MAHSOOL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MAHSOOL_EMBEDDING_DIM=1024
# Leave QDRANT_URL empty to use embedded Qdrant under data/qdrant (no Docker needed)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
MAHSOOL_QDRANT_COLLECTION=fbr_laws

# --- Storage ---
DATABASE_URL=postgresql://mahsool:mahsool@localhost:5432/mahsool

# --- Tracing (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
