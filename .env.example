# Copy to .env and fill in. Never commit .env.

# --- Ingestion ---
MAHSOOL_DATA_DIR=data
MAHSOOL_MAX_CHUNK_TOKENS=800

# --- LLMs: a provider (groq | gemini) and a model per role, see backend/app/config.py ---
GROQ_API_KEY=
GEMINI_API_KEY=
MAHSOOL_ANSWER_PROVIDER=groq
MAHSOOL_ANSWER_MODEL=openai/gpt-oss-120b
MAHSOOL_REWRITE_PROVIDER=groq
MAHSOOL_REWRITE_MODEL=openai/gpt-oss-20b
MAHSOOL_JUDGE1_PROVIDER=gemini
MAHSOOL_JUDGE1_MODEL=gemini-3-flash
MAHSOOL_JUDGE2_PROVIDER=groq
MAHSOOL_JUDGE2_MODEL=qwen/qwen3.8-27b

# --- Retrieval ---
MAHSOOL_EMBEDDING_MODEL=BAAI/bge-m3
MAHSOOL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MAHSOOL_EMBEDDING_DIM=1024
# Empty QDRANT_URL = embedded Qdrant stored under data/qdrant (default, no Docker or server needed).
# Set it only for a Qdrant server, e.g. Qdrant Cloud or the optional docker-compose.yml.
QDRANT_URL=
QDRANT_API_KEY=
MAHSOOL_QDRANT_COLLECTION=fbr_laws

# --- Storage (needed from Milestone 4) ---
# Free hosted Postgres on Neon (https://neon.tech): copy the connection string from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/mahsool?sslmode=require

# --- Tracing (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
